def ask_confirmation(prompt):
    return input(f"{prompt} [y/N] ").strip().lower() in ("y", "yes")


def parse_mount(spec, guest_home, hidden, force, remedy=FORCE_REMEDY):
    parts = spec.split(":")
    if not 1 <= len(parts) <= 3:
        raise SystemExit(f"invalid mount '{spec}': expected HOST[:GUEST[:ro|rw|tmp]]")
    host = parts[0]
    guest = parts[1] if len(parts) > 1 else ""
    mode = parts[2] if len(parts) > 2 else "ro"
    if mode not in ("ro", "rw", "tmp"):
        raise SystemExit(f"invalid mount mode '{mode}' in '{spec}': "
                         f"expected 'ro', 'rw' or 'tmp'")
    # '~' is the sandbox home, so that one spec suits every sandbox user.
    if guest == "~" or guest.startswith("~/"):
        guest = str(guest_home) + guest[1:]
    if guest and not guest.startswith("/"):
        raise SystemExit(f"invalid mount target '{guest}' in '{spec}': expected an absolute "
                         f"path or one under '~'")

    source = Path(host).expanduser().resolve()
    if not source.exists():
        raise SystemExit(f"mount source '{source}' does not exist")
    guard_path(source, hidden, force, f"refusing to mount '{source}'", remedy)
    # GUEST mirrors the host path by default, so a relative reference such as a
    # cargo path dependency on '../core' still resolves inside.
    return source, Path(guest) if guest else source, mode


def parse_env(spec):
    name, separator, value = spec.partition("=")
    if not ENV_NAME_RE.match(name):
        raise SystemExit(f"invalid variable name '{name}'")
    if separator:
        return name, value
    if name not in os.environ:
        # An empty variable and an unforwarded one look identical inside, so a
        # missing name has to be an error rather than a silent no-op.
        raise SystemExit(f"'{name}' is not set on the host, so there is nothing to forward")
    return name, os.environ[name]


def wayland_display(origin):
    display = os.environ.get("WAYLAND_DISPLAY")
    if not display:
        raise SystemExit(f"{origin}: WAYLAND_DISPLAY is not set on the host, so there is no "
                         f"display to give")
    socket_path = Path(display) if display.startswith("/") else RUNTIME_DIR / display
    if not socket_path.is_socket():
        raise SystemExit(f"{origin}: '{socket_path}' is not a socket")
    return display, socket_path


def is_address(text):
    try:
        ipaddress.ip_address(text)
    except ValueError:
        return False
    return True


def read_vpn(path):
    """The wg-quick config at PATH, split as wg-quick splits it.

    Returns the text for 'wg setconf', the addresses, the MTU or None, and a
    resolv.conf. A DNS entry that is an address is a nameserver there, and
    any other is a search domain.
    """
    try:
        lines = path.read_text().splitlines()
    except OSError as error:
        raise SystemExit(f"cannot read the VPN config '{path}': {error.strerror}")
    config, addresses, dns, mtu = [], [], [], None
    interface = False
    for line in lines:
        key, _, value = line.partition("#")[0].partition("=")
        key = key.strip().lower()
        if key.startswith("["):
            interface = key == "[interface]"
        if not (interface and key in WG_QUICK_KEYS):
            config.append(line)
        elif key == "address":
            addresses += value.replace(",", " ").split()
        elif key == "dns":
            dns += value.replace(",", " ").split()
        elif key == "mtu":
            mtu = value.strip()
    if not addresses:
        raise SystemExit(f"no Address in the [Interface] of the VPN config '{path}'")
    try:
        addresses = [ipaddress.ip_interface(address) for address in addresses]
    except ValueError as error:
        raise SystemExit(f"invalid Address in the VPN config '{path}': {error}")
    resolv = "".join(f"nameserver {entry}\n" for entry in dns if is_address(entry))
    domains = [entry for entry in dns if not is_address(entry)]
    if domains:
        resolv += f"search {' '.join(domains)}\n"
    return "\n".join(config) + "\n", addresses, mtu, resolv


def guard_path(path, hidden, force, message, remedy=FORCE_REMEDY):
    if force:
        return
    if path == Path("/") or path == Path.home().resolve():
        raise SystemExit(f"{message}: it is the home directory or the filesystem root.\n"
                         f"Everything below it would come along. {remedy}")
    # A bind of the parent would show the hidden directory again. A tmpfs on
    # it there would also cover the mounts that come after.
    for directory in hidden:
        if path in directory.parents:
            raise SystemExit(f"{message}: it holds the hidden directory '{directory}'.\n"
                             f"{remedy}")


def guard_overlays(mounts):
    """Refuse the overlay sources that overlayfs cannot take.

    Neither case reports itself. A source inside another source is left
    undefined by overlayfs, and the kernel takes it without a word. A source
    with a mount point inside it comes back from bwrap as 'Invalid argument'
    on a mount the caller never wrote.
    """
    sources = [source for source, _, mode in mounts if mode == "tmp"]
    if not sources:
        return
    mounted = [Path(line.split()[4])
               for line in Path("/proc/self/mountinfo").read_text().splitlines()]
    for source in sources:
        for other in sources:
            if source in other.parents:
                raise SystemExit(f"refusing to overlay '{other}' inside '{source}': "
                                 f"overlayfs forbids one source under another")
        for point in mounted:
            if source in point.parents:
                raise SystemExit(f"cannot overlay '{source}': '{point}' is mounted inside it.\n"
                                 f"overlayfs refuses a lower layer that holds a mount point.")


def bwrap_has_overlay():
    usage = subprocess.run(["bwrap", "--help"], capture_output=True, text=True)
    return "--tmp-overlay" in usage.stdout + usage.stderr


def guard_bwrap_overlay(mounts):
    """bwrap grew the overlay options in 0.11.0. An older one dies on the first
    of them with 'Unknown option', which does not say what to install."""
    if all(mode != "tmp" for _, _, mode in mounts):
        return
    if not bwrap_has_overlay():
        raise SystemExit("':tmp' needs bwrap 0.11.0 or newer; this one has no --tmp-overlay.")


def generated_dir(homes, username):
    # A leading dot is not a legal username, so this cannot collide with one.
    return homes / ".corral" / username


def cipher_dir(homes, username):
    """Where the blocks of an encrypted home rest, next to its mount point."""
    return homes / f".{username}.cryfs"


def staging_dir(homes, username):
    """The mount point of a cipher directory in the making."""
    return homes / f".{username}.mount"


def mounted(path):
    return any(Path(line.split()[4]) == path
               for line in Path("/proc/self/mountinfo").read_text().splitlines())


def process_with(*arguments):
    """The command line of a process on the host that has ARGUMENTS in a row,
    or None."""
    wanted = list(arguments)
    for cmdline in Path("/proc").glob("[0-9]*/cmdline"):
        try:
            argv = cmdline.read_bytes().decode(errors="replace").split("\0")
        except OSError:
            continue
        for index in range(len(argv)):
            if argv[index:index + len(wanted)] == wanted:
                return argv
    return None


def cryfs_command(cipher, mount_point, *options):
    return ["env", *CRYFS_ENV, "cryfs", *options, str(cipher), str(mount_point)]


def mount_cipher(cipher, mount_point, passphrase, *options):
    """cryfs makes a new filesystem when the cipher directory is empty."""
    run = subprocess.run(cryfs_command(cipher, mount_point, *options), capture_output=True,
                         text=True, input=passphrase + "\n")
    # cryfs exits 0 when fuse refuses a mount point that is not empty.
    if run.returncode != 0 or not mounted(mount_point):
        said = (run.stderr.strip() or run.stdout.strip().rpartition("\n")[2]
                or f"cryfs exited with {run.returncode}")
        raise SystemExit(f"cannot mount '{cipher}' on '{mount_point}': {said}")


def unmount(mount_point):
    run = subprocess.run(["fusermount", "-u", str(mount_point)], capture_output=True, text=True)
    if run.returncode != 0:
        raise SystemExit(f"cannot unmount '{mount_point}': {run.stderr.strip()}")


def read_passphrase(config, username):
    """From the key command, with the user as its argument, else from the terminal."""
    if "key_command" not in config:
        return getpass.getpass(f"Passphrase for '{username}': ")
    command = config["key_command"]
    if not isinstance(command, str):
        raise SystemExit(f"'key_command' in '{CONFIG_PATH}' must be a string")
    # stdin and stderr stay on the terminal, so that 'pass' can ask for its
    # own passphrase.
    run = subprocess.run(["sh", "-c", command, "sh", username], stdout=subprocess.PIPE, text=True)
    if run.returncode != 0:
        raise SystemExit(f"'key_command' in '{CONFIG_PATH}' failed with status {run.returncode}")
    return run.stdout.rstrip("\n")


def new_passphrase(config, username):
    passphrase = read_passphrase(config, username)
    if not passphrase:
        raise SystemExit("The passphrase is empty.")
    if "key_command" not in config and getpass.getpass("Again: ") != passphrase:
        raise SystemExit("The passphrases differ.")
    return passphrase


def unlock_home(homes, username, config):
    """Mount the cipher directory on the home, unless it is mounted already.

    cryfs mounts a cipher directory a second time without a word, and two of
    them corrupt it. A 'cryfs-unmount' by hand under a running sandbox leaves
    exactly that: the mount point is gone, the daemon lives on through the
    sandbox's bind.
    """
    home = homes / username
    if mounted(home):
        return
    cipher = cipher_dir(homes, username)
    if not shutil.which("cryfs"):
        raise SystemExit(f"the home of '{username}' is encrypted and needs 'cryfs'; is the cryfs "
                         f"package installed?")
    if process_with("cryfs", str(cipher)):
        raise SystemExit(f"cryfs already serves '{cipher}', mounted elsewhere or detached under "
                         f"a sandbox that still runs, and a second mount would corrupt it.\n"
                         f"Exit that sandbox, or unmount it, and try again.")
    mount_cipher(cipher, home, read_passphrase(config, username))


def prepare_home(homes, username, config, dry_run):
    """The home, created, unlocked when it is encrypted, and seeded.

    A dry run mounts nothing, and the seed would then land on the bare mount
    point, which cryfs refuses as not empty from there on.
    """
    home = homes / username
    if not home.is_dir():
        home.mkdir(parents=True)
        print(f"Created '{home}'.", file=sys.stderr)
    if cipher_dir(homes, username).is_dir():
        if dry_run:
            print(shlex.join(cryfs_command(cipher_dir(homes, username), home)))
            return home
        unlock_home(homes, username, config)
    seed_home(home)
    return home


def tree_entries(root):
    """Every path under ROOT with its kind, links not followed."""
    for directory, subdirectories, files in os.walk(root):
        for name in subdirectories + files:
            path = Path(directory, name)
            if path.is_symlink():
                kind = "link"
            elif path.is_dir():
                kind = "dir"
            elif path.is_file():
                kind = "file"
            else:
                kind = "special"
            yield path.relative_to(root), kind


def copy_tree(source, target):
    """Copy SOURCE into TARGET. A hard link becomes a file of its own, and a
    socket, pipe or device is left out: cryfs cannot hold them. Returns how
    many were left out."""
    skipped = 0
    for relative, kind in tree_entries(source):
        original, copy = source / relative, target / relative
        if kind == "dir":
            copy.mkdir()
            shutil.copymode(original, copy)
        elif kind == "link":
            os.symlink(os.readlink(original), copy)
        elif kind == "file":
            shutil.copy2(original, copy)
        else:
            skipped += 1
    return skipped


def first_difference(source, copy):
    """The first path whose copy is not the same, or None."""
    for relative, kind in tree_entries(source):
        original, copied = source / relative, copy / relative
        if kind == "dir":
            same = copied.is_dir()
        elif kind == "link":
            same = copied.is_symlink() and os.readlink(copied) == os.readlink(original)
        elif kind == "file":
            same = copied.is_file() and filecmp.cmp(original, copied, shallow=False)
        else:
            same = True
        if not same:
            return relative
    return None


def fill_cipher(home, cipher, staging, passphrase):
    """Copy the home into the new cipher directory, and compare after a fresh
    mount, so that what is compared comes from the blocks on disk and not from
    the cache of cryfs."""
    # cryfs remembers the filesystem it last saw in a directory and refuses
    # another one there, which a new one after 'remove' or a failed attempt is.
    mount_cipher(cipher, staging, passphrase, "--allow-replaced-filesystem")
    try:
        skipped = copy_tree(home, staging)
    except OSError as error:
        raise SystemExit(f"cannot encrypt '{home}': {error}")
    unmount(staging)
    mount_cipher(cipher, staging, passphrase)
    different = first_difference(home, staging)
    unmount(staging)
    if different:
        raise SystemExit(f"the copy of '{different}' differs from the original; nothing was deleted")
    return skipped


def generated_etc(directory, username, guest_home, shell):
    """The /etc files that have to describe the sandbox rather than the host.

    The sandbox runs as the caller's own uid and gid, under the sandbox user's
    name. passwd matters because some tools read $HOME while others call
    getpwuid(). Both have to give the sandbox home, or agent state lands in a
    directory that is not mounted.
    """
    uid, gid = os.getuid(), os.getgid()

    def replaced(source, number, added):
        lines = [line for line in Path(source).read_text().splitlines()
                 if line.split(":")[2:3] != [str(number)]]
        return "\n".join(lines + [added]) + "\n"

    files = {
        "/etc/passwd": replaced("/etc/passwd", uid,
                                f"{username}:x:{uid}:{gid}::{guest_home}:{shell}"),
        "/etc/group": replaced("/etc/group", gid, f"{username}:x:{gid}:"),
    }
    written = {}
    for guest, text in files.items():
        path = directory / Path(guest).name
        path.write_text(text)
        written[guest] = path
    return written


def seed_home(home):
    """Give a fresh sandbox home the shell files the distribution ships.

    Without them the prompt has no colours, no history and no completion, and
    there is nowhere obvious to put a variable that every session needs.
    """
    skeleton = Path("/etc/skel")
    if not skeleton.is_dir():
        return
    for entry in skeleton.iterdir():
        target = home / entry.name
        if entry.is_file() and not target.exists():
            shutil.copy(entry, target)


def scaffold(target, tmpfs_roots):
    """Arguments that let bwrap create the mount point for TARGET.

    The rootfs arrives read only, so a bind whose target does not already
    exist fails outright. Replacing the parent with a tmpfs makes the mkdir
    possible, and the parent's real entries are bound back so that nothing
    which was there disappears.

    What a re-bound entry cannot bring back is a mount, so these have to be
    emitted before the sandbox's own. '-m src:/data' replaces '/' to create
    '/data'; run after '--tmpfs /home' that would bury it and put the host's
    real home back in its place, read only but entirely readable.
    """
    if any(target == root or root in target.parents for root in tmpfs_roots):
        return []
    if target.exists():
        return []
    parent = target.parent
    if not parent.is_dir():
        raise SystemExit(f"cannot mount at '{target}': '{parent}' does not exist on the host")
    tmpfs_roots.append(parent)
    args = ["--tmpfs", str(parent)]
    for child in sorted(parent.iterdir()):
        args += ["--ro-bind", str(child), str(child)]
    return args


def hidden_paths(sources, extra):
    """The files and the directories to hide, EXTRA included.

    Links are resolved, because bwrap refuses to mount on one, and /home is
    one on Fedora Atomic. The real home is hidden also when it is not under
    /home, such as /root.
    """
    files, directories = [], []
    for spec in HIDDEN + ("/home", "~") + tuple(config_hide(sources)) + extra:
        path = Path(spec).expanduser().resolve()
        # bwrap cannot mount on a path in a directory that the caller cannot
        # read, such as /run/containerd. A path that the caller cannot open
        # needs no hiding.
        if path.is_dir():
            if path != Path("/") and (os.access(path, os.R_OK) or os.access(path, os.X_OK)):
                directories.append(path)
        elif os.access(path, os.R_OK) or os.access(path, os.W_OK):
            files.append(path)
    # A tmpfs inside another one would leave its mount point there.
    directories = [directory for directory in dict.fromkeys(directories)
                   if not any(other in directory.parents for other in directories + list(SCRATCH))]
    return files, directories


def hide_targets(hidden, layers):
    """Where HIDDEN shows inside the sandbox.

    LAYERS are (source, target) in mount order, with None as the source of a
    tmpfs. A bind of a directory that holds HIDDEN shows it again at a new
    path, because bwrap binds from the host view, where the /dev/null bind is
    not. A later layer can also cover HIDDEN, and then nothing is left to hide.
    """
    def shown(guest):
        for source, target in reversed(layers):
            if guest == target or target in guest.parents:
                return source and source / guest.relative_to(target)

    targets = []
    for source, target in layers:
        if source and (hidden == source or source in hidden.parents):
            guest = target / hidden.relative_to(source)
            if shown(guest) == hidden and guest not in targets:
                targets.append(guest)
    return targets


def tty_filter(machine):
    """A seccomp program that refuses TIOCSTI and TIOCLINUX, or None where the
    numbers are not known.

    Only the low half of the request is compared, because the kernel reads 32
    bits. Flatpak compared 64, and 'TIOCSTI | 1 << 32' went through
    (CVE-2019-10063).
    """
    if machine not in IOCTL_CALLS:
        return None

    def instruction(code, value, if_true=0, if_false=0):
        return struct.pack("=HBBI", code, if_true, if_false, value)

    requests = [instruction(BPF_LOAD_WORD, SECCOMP_REQUEST)]
    for index, request in enumerate(TTY_REQUESTS):
        later = len(TTY_REQUESTS) - 1 - index
        requests.append(instruction(BPF_JUMP_IF_EQUAL, request,
                                    if_true=later, if_false=0 if later else 1))
    requests.append(instruction(BPF_RETURN, SECCOMP_REFUSE))

    program = []
    for arch, numbers in IOCTL_CALLS[machine]:
        for number in numbers:
            block = [instruction(BPF_LOAD_WORD, SECCOMP_NUMBER),
                     instruction(BPF_JUMP_IF_EQUAL, number, if_false=len(requests))] + requests
            program += [instruction(BPF_LOAD_WORD, SECCOMP_ARCH),
                        instruction(BPF_JUMP_IF_EQUAL, arch, if_false=len(block))] + block
    program.append(instruction(BPF_RETURN, SECCOMP_ALLOW))
    return b"".join(program)


def choose_shell(sources, hidden):
    """The interactive shell: the 'shell' key, else $SHELL, else bash.

    $SHELL comes from the environment and was not chosen for corral, so one
    that the sandbox cannot run falls back to bash. A bad key is an error.
    """
    def runnable(shell):
        path = Path(shell).expanduser()
        resolved = path.resolve()
        return (path.is_absolute() and resolved.is_file() and os.access(resolved, os.X_OK)
                and not any(root in resolved.parents for root in hidden + list(SCRATCH)))

    label, shell = setting(sources, "shell")
    if label:
        if not (isinstance(shell, str) and runnable(shell)):
            raise SystemExit(f"invalid 'shell' in '{label}': expected the absolute path of "
                             f"a program that the sandbox shows")
        return str(Path(shell).expanduser())
    shell = os.environ.get("SHELL", "")
    return shell if shell and runnable(shell) else "/bin/bash"


def inside_project(target, project_dir):
    return project_dir is not None and (target == project_dir or project_dir in target.parents)


def bind_args(source, target, mode):
    return ["--bind" if mode == "rw" else "--ro-bind", str(source), str(target)]


def choose_user(config, project, args):
    username = args.user or project.get("user") or config.get("default_user") or DEFAULT_USER
    if not USERNAME_RE.match(username):
        raise SystemExit(f"invalid user '{username}': expected {USERNAME_RE.pattern}")
    return username


def chosen_vpn(sources, args):
    """The wg-quick config of --vpn, else of the 'vpn' key, and what names it."""
    if args.vpn:
        return Path(args.vpn).expanduser().absolute(), "--vpn"
    label, path = setting(sources, "vpn")
    if not label:
        return None, None
    origin = f"'vpn' in '{label}'"
    if not (isinstance(path, str) and Path(path).expanduser().is_absolute()):
        raise SystemExit(f"invalid {origin}: expected an absolute path or one under '~'")
    return Path(path).expanduser(), origin


def chosen_wayland(sources, args):
    """--wayland or --no-wayland, else the 'wayland' key, and what names it."""
    if args.wayland is not None:
        return args.wayland, "--wayland"
    label, wayland = setting(sources, "wayland")
    if not label:
        return False, None
    origin = f"'wayland' in '{label}'"
    if not isinstance(wayland, bool):
        raise SystemExit(f"invalid {origin}: expected true or false")
    return wayland, origin


def build_command(sources, project, args, username):
    network = (args.net or project.get("network") or setting(sources, "network")[1]
               or DEFAULT_NETWORK)
    if network not in NETWORKS:
        raise SystemExit(f"invalid network '{network}': expected one of {', '.join(NETWORKS)}")
    vpn, vpn_origin = chosen_vpn(sources, args)
    if vpn:
        if network != "private":
            raise SystemExit(f"{vpn_origin} needs the network mode 'private', not '{network}'")
        if vpn.exists() and not vpn.is_file():
            raise SystemExit(f"{vpn_origin}: '{vpn}' is not a regular file, and corral reads it "
                             f"again inside the network namespace")
        _, _, _, resolv = read_vpn(vpn)
    if network == "private" and not shutil.which("pasta"):
        raise SystemExit("network 'private' needs 'pasta', from the 'passt' package.\n"
                         "Install it, or pass '-n host' to share the host's network.")
    if vpn and not shutil.which("wg"):
        raise SystemExit(f"{vpn_origin} needs 'wg', from the wireguard-tools package.")

    # The VPN config holds the private key of the tunnel.
    hidden_files, hidden_directories = hidden_paths(sources, RESOLVERS + (str(vpn),) if vpn else ())
    shell = choose_shell(sources, hidden_directories)
    guest_home = Path("/home").resolve() / username

    project_dir = CWD if args.project else None
    if project_dir:
        guard_path(project_dir, hidden_directories, args.force,
                   f"refusing '{project_dir}' as the project")
    mounts = ([parse_mount(spec, guest_home, hidden_directories, False, CONFIG_REMEDY.format(label))
               for label, spec in config_mounts(sources)]
              + [parse_mount(spec, guest_home, hidden_directories, False, PROJECT_REMEDY)
                 for spec in project.get("mounts", [])]
              + [parse_mount(spec, guest_home, hidden_directories, args.force)
                 for spec in args.mount])
    guard_overlays(mounts)
    guard_bwrap_overlay(mounts)
    configured = [spec for specs in config_env(sources, project, args) for spec in specs]
    variables = [parse_env(spec) for spec in configured + project_env(project, args) + args.env]
    wayland, wayland_origin = chosen_wayland(sources, args)
    if wayland:
        display, socket_path = wayland_display(wayland_origin)
        mounts.append((socket_path, socket_path, "ro"))
        variables.append(("WAYLAND_DISPLAY", display))

    homes = Path(setting(sources, "homes")[1]).expanduser()
    home = homes / username
    generated = generated_dir(homes, username)
    generated.mkdir(parents=True, exist_ok=True)

    # A hidden directory, '/home' included, is replaced wholesale, which means
    # every later bind under it has to come after this one.
    tmpfs_roots = hidden_directories + [Path("/tmp"), Path("/var/tmp")]
    if RUNTIME_DIR.is_dir():
        tmpfs_roots.append(RUNTIME_DIR)

    # Worked out before the sandbox's own mounts and emitted ahead of them,
    # because the parent a mount point needs is often an ancestor of one of
    # them; see scaffold. Nothing here is placed under a tmpfs that is about to
    # be laid down, since bwrap creates a mount point in a tmpfs by itself.
    # Nor under the project: that is writable, so bwrap creates the mount
    # point there, and it stays on the host.
    scaffolding = []
    for _, target, _ in mounts:
        if not inside_project(target, project_dir):
            scaffolding += scaffold(target, tmpfs_roots)

    # What each mount shows, for the daemon sockets to be hidden at every path.
    layers = [(Path("/"), Path("/"))]
    command = ["bwrap", "--ro-bind", "/", "/"] + scaffolding + ["--dev", "/dev", "--proc", "/proc"]
    # Before the scratch tmpfs mounts, because 'hide = ["/var"]' would bury
    # '/var/tmp'.
    for directory in hidden_directories:
        command += ["--tmpfs", str(directory)]
        layers.append((None, directory))
    command += ["--tmpfs", "/tmp", "--tmpfs", "/var/tmp"]
    layers += [(None, Path("/tmp")), (None, Path("/var/tmp"))]
    if RUNTIME_DIR.is_dir():
        command += ["--perms", "0700", "--tmpfs", str(RUNTIME_DIR)]
        layers.append((None, RUNTIME_DIR))

    command += ["--bind", str(home), str(guest_home)]
    layers.append((home.resolve(), guest_home))

    binds = [(source, target, mode) for source, target, mode in mounts if mode != "tmp"]
    for source, target, mode in binds:
        if not inside_project(target, project_dir):
            command += bind_args(source, target, mode)
            layers.append((source, target))

    # Last of the binds, because the project usually lives under a directory
    # that one of the tmpfs mounts above has just emptied.
    if project_dir:
        command += ["--bind", str(project_dir), str(project_dir)]
        layers.append((project_dir, project_dir))

    # Except for a bind inside the project, which that bind would cover.
    # '-m .::ro' is the project itself, read only.
    for source, target, mode in binds:
        if inside_project(target, project_dir):
            command += bind_args(source, target, mode)
            layers.append((source, target))

    # After every bind, because an overlay has to sit on top of whatever holds
    # its target. An overlay on a directory inside the project needs the
    # project bound first, or that bind covers it and the writes it was asked
    # to throw away reach the host instead.
    for source, target, mode in mounts:
        if mode == "tmp":
            command += ["--overlay-src", str(source), "--tmp-overlay", str(target)]
            layers.append((source, target))

    # After the overlays in turn: '-m /etc::tmp' would otherwise bury these two
    # and the sandbox would answer getpwuid() with the caller's host entry.
    for guest, path in generated_etc(generated, username, guest_home, shell).items():
        command += ["--ro-bind", str(path), guest]
    if vpn:
        # On the link target, because bwrap cannot mount on a link, and
        # /etc/resolv.conf is one under systemd-resolved.
        resolv_path = generated / "resolv.conf"
        resolv_path.write_text(resolv)
        command += ["--ro-bind", str(resolv_path), str(Path("/etc/resolv.conf").resolve())]

    seccomp = tty_filter(platform.machine())
    if seccomp:
        seccomp_path = generated / "seccomp.bpf"
        seccomp_path.write_bytes(seccomp)

    for hidden in hidden_files:
        for target in hide_targets(hidden, layers):
            command += ["--ro-bind", "/dev/null", str(target)]

    # Those tmpfs mounts exist to carry mount points and nothing else, so
    # nothing should be writing into one. Left writable, a write into the empty
    # '/home/<you>' standing above the project, or into a directory invented to
    # hold a '-m' target, succeeds and then disappears at exit: exactly the
    # quiet loss that a read-only rootfs exists to turn into an error.
    #
    # This has to come after every bind, because bwrap applies operations in
    # order and a bind needs its mount point to be writable at the moment it is
    # made. '--remount-ro' does not recurse, so the binds underneath stay
    # writable. Scratch is left alone. So is a tmpfs that a bind covers, such
    # as a hidden directory that is also the project: the remount would reach
    # the bind.
    bound = [target for source, target in layers if source and target != Path("/")]
    for root in tmpfs_roots:
        covered = any(target == root or target in root.parents for target in bound)
        if root not in SCRATCH and not covered:
            command += ["--remount-ro", str(root)]

    # The caller's own bin directories are gone with the home, so an entry that
    # points into it would only slow every lookup down.
    real_home = str(Path.home().resolve())
    inherited = [entry for entry in os.environ.get("PATH", "").split(":")
                 if entry and not entry.startswith(real_home + "/")]
    path = ":".join([f"{guest_home}/.local/bin", f"{guest_home}/.cargo/bin"] + inherited)

    command += [
        "--setenv", "HOME", str(guest_home),
        "--setenv", "USER", username,
        "--setenv", "LOGNAME", username,
        "--setenv", "SHELL", shell,
        "--setenv", "PATH", path,
        # The only reliable way to tell from inside that this is a sandbox.
        # USER and the hostname can both be anything, so a shell prompt, a
        # .bashrc or a script that must not run on the host needs its own name
        # to test. It doubles as the guard against nesting; see main().
        "--setenv", "CORRAL", "1",
        "--setenv", "CORRAL_USER", username,
        # claude renders in the alternate screen otherwise, which terminals
        # keep no scrollback for.
        "--setenv", "CLAUDE_CODE_DISABLE_ALTERNATE_SCREEN", "1",
    ]
    if project_dir:
        command += ["--setenv", "CORRAL_PROJECT", str(project_dir)]
    for name in DROPPED_ENV:
        command += ["--unsetenv", name]
    for name, value in variables:
        command += ["--setenv", name, value]

    command += [
        # The caller's ids in every network mode. Under pasta, bwrap starts
        # as uid 0 and maps them onto it.
        "--unshare-user", "--uid", str(os.getuid()), "--gid", str(os.getgid()),
        # bwrap keeps every capability for a caller that is root. With them,
        # the sandbox could unmount or remount its own read-only mounts.
        "--cap-drop", "ALL",
        "--unshare-pid",
        "--unshare-ipc",
        # Fixed, because the network helper otherwise renames the host and the
        # prompt would then depend on which network mode was chosen.
        "--unshare-uts", "--hostname", HOSTNAME,
        "--die-with-parent",
        "--chdir", str(project_dir or guest_home),
    ]

    if network == "none":
        command += ["--unshare-net"]
    if seccomp:
        command += ["--seccomp", "3"]

    # A command runs in bash whatever the shell, because the command is quoted
    # for a POSIX shell, and fish reads a backslash in quotes in another way.
    command += (["--", "bash", "-lc", shlex.join(args.command)] if args.command
                else ["--", shell, "-l"])

    if seccomp:
        # pasta closes every inherited file descriptor, so the filter is opened
        # after it, just before bwrap.
        command = ["sh", "-c", 'exec "$@" 3<"$0"', str(seccomp_path)] + command

    if vpn:
        command = [sys.executable, str(Path(__file__).resolve()), VPN_HELPER, str(vpn)] + command

    if network == "private":
        # pasta forwards ports both ways unless told not to: a port bound on
        # the host answers inside, and a port bound inside is bound on the
        # host. --no-map-gw closes the third way in, the host behind the
        # gateway address. The sandbox reads the resolv.conf of the host and
        # never asks pasta for a nameserver. Without --dns none, pasta warns
        # at every start when the only nameserver is on the host loopback, as
        # with systemd-resolved, because --no-map-gw makes it drop that one.
        command = ["pasta", "--config-net", "--quiet",
                   "--tcp-ports", "none", "--udp-ports", "none",
                   "--tcp-ns", "none", "--udp-ns", "none",
                   "--no-map-gw", "--dns", "none", "--"] + command

    return command


def run_step(command, **options):
    """One step of the tunnel setup. The tool itself says what went wrong."""
    if subprocess.run(command, **options).returncode != 0:
        raise SystemExit(f"--vpn: '{shlex.join(command)}' failed")


def vpn_helper(path, command):
    """Set up the tunnel of the VPN config at PATH, then exec COMMAND.

    corral runs itself again for this inside pasta, as root of the user
    namespace of pasta. wg0 is made in the network namespace of pasta, where
    its UDP socket stays, and is then moved into a new namespace that has
    nothing else. The sandbox starts there, without the capabilities to change
    it. The config is read again here, because pasta closes every inherited
    file descriptor, and the private key must not go on a command line, into
    the environment or into a file.
    """
    config, addresses, mtu, _ = read_vpn(path)
    run_step(["ip", "link", "add", "wg0", "type", "wireguard"])
    run_step(["wg", "setconf", "wg0", "/dev/stdin"], input=config, text=True)
    outer = os.open("/proc/self/ns/net", os.O_RDONLY)
    CLONE_NEWNET = 0x40000000
    if ctypes.CDLL(None, use_errno=True).unshare(CLONE_NEWNET) != 0:
        raise SystemExit(f"--vpn: cannot make a network namespace: "
                         f"{os.strerror(ctypes.get_errno())}")
    run_step(["nsenter", f"--net=/proc/self/fd/{outer}",
              "ip", "link", "set", "wg0", "netns", str(os.getpid())], pass_fds=[outer])
    os.close(outer)
    run_step(["ip", "link", "set", "lo", "up"])
    for address in addresses:
        run_step(["ip", "address", "add", str(address), "dev", "wg0"])
    run_step(["ip", "link", "set", "wg0", "up"] + (["mtu", mtu] if mtu else []))
    for version in sorted({address.version for address in addresses}):
        run_step(["ip", f"-{version}", "route", "add", "default", "dev", "wg0"])
    os.execvp(command[0], command)


def die_with_parent():
    PR_SET_PDEATHSIG = 1
    ctypes.CDLL(None, use_errno=True).prctl(PR_SET_PDEATHSIG, signal.SIGKILL)


def run_sandbox(command):
    """Run the sandbox and wait for it, so that work after the exit has a process.

    Ctrl-C reaches the whole foreground group, corral included. The command
    handles it; corral only waits. A Python handler rather than SIG_IGN,
    because an ignored signal survives exec and the command would start deaf
    to Ctrl-C. The child takes SIGKILL when corral dies: bwrap does that for
    its own child, pasta does not.
    """
    for signum in (signal.SIGINT, signal.SIGQUIT):
        signal.signal(signum, lambda *_: None)
    status = subprocess.run(command, preexec_fn=die_with_parent).returncode
    return 128 - status if status < 0 else status


def run_and_lock(command, home):
    """Run the sandbox, then lock the home unless another sandbox of the user
    still uses it.

    The kernel counts the users of each mount on its own, and a sandbox uses
    the home through a bind of its own, so the unmount on the host would go
    through under a running sandbox. Each corral holds the host mount open
    instead, and fusermount refuses with 'busy' while any does.
    """
    held = os.open(home, os.O_RDONLY | os.O_DIRECTORY)
    try:
        return run_sandbox(command)
    finally:
        os.close(held)
        subprocess.run(["fusermount", "-u", str(home)], capture_output=True)


def disk_usage(root):
    """du counts a hard link once, and a walk in Python takes seconds on a
    home with a toolchain in it. For a directory that it cannot read, du
    exits 1 and still gives the total of the rest."""
    run = subprocess.run(["du", "-s", "-B1", str(root)], stdout=subprocess.PIPE,
                         stderr=subprocess.DEVNULL, text=True)
    return int(run.stdout.split()[0])


def format_size(size):
    unit = "B"
    for larger in ("K", "M", "G", "T"):
        if size < 1024:
            break
        size /= 1024
        unit = larger
    if unit == "B":
        return f"{size}B"
    return f"{size:.1f}{unit}" if size < 10 else f"{size:.0f}{unit}"


def last_used(homes, username):
    """The generated passwd is rewritten at every start, so its mtime is the
    last start without a marker file to keep."""
    stamp = generated_dir(homes, username) / "passwd"
    if not stamp.exists():
        return "never"
    return datetime.fromtimestamp(stamp.stat().st_mtime).strftime("%Y-%m-%d %H:%M")


def sandbox_homes(homes):
    """A home is a directory in the root whose name could be a sandbox user.

    That leaves out the generated '.corral' directory, and it leaves out a
    symbolic link, which points somewhere the root does not own.
    """
    return sorted(entry.name for entry in homes.iterdir()
                  if USERNAME_RE.match(entry.name) and entry.is_dir() and not entry.is_symlink())


def list_homes(rest):
    argparse.ArgumentParser(prog="corral list",
                            description="List the sandbox homes.").parse_args(rest)
    homes = Path(load_settings()["homes"]).expanduser()
    names = sandbox_homes(homes)
    if not names:
        print(f"No sandbox homes under '{homes}'.")
        return
    width = max(len(name) for name in names + ["USER"])
    print(f"{'USER':<{width}}  {'SIZE':>5}  {'LAST USED':<16}  {'STATE':<8}  HOME")
    for name in names:
        home = homes / name
        cipher = cipher_dir(homes, name)
        if cipher.is_dir():
            state, usage = "unlocked" if mounted(home) else "locked", disk_usage(cipher)
        else:
            state, usage = "plain", disk_usage(home)
        print(f"{name:<{width}}  {format_size(usage):>5}  "
              f"{last_used(homes, name):<16}  {state:<8}  {home}")


def remove_home(rest):
    parser = argparse.ArgumentParser(prog="corral remove",
                                     description="Delete a sandbox user's home.")
    parser.add_argument("user", help="the sandbox user whose home to delete")
    username = parser.parse_args(rest).user
    if not USERNAME_RE.match(username):
        raise SystemExit(f"invalid user '{username}': expected {USERNAME_RE.pattern}")
    homes = Path(load_settings()["homes"]).expanduser()
    home = homes / username
    cipher = cipher_dir(homes, username)
    if home.is_symlink():
        raise SystemExit(f"refusing to remove '{home}': it is a symbolic link")
    if not home.is_dir():
        raise SystemExit(f"there is no '{username}' sandbox under '{homes}'")
    if process_with("--bind", str(home)):
        raise SystemExit(f"a sandbox of '{username}' runs; exit it first.")
    usage = disk_usage(cipher if cipher.is_dir() else home)
    if not ask_confirmation(f"Remove '{home}' ({format_size(usage)})?"):
        raise SystemExit("Aborted.")
    if mounted(home):
        unmount(home)
    shutil.rmtree(home)
    if cipher.is_dir():
        shutil.rmtree(cipher)
    generated = generated_dir(homes, username)
    if generated.is_dir():
        shutil.rmtree(generated)
    print(f"Removed '{home}'.")


def encrypt_home(rest):
    parser = argparse.ArgumentParser(prog="corral encrypt",
                                     description="Put a sandbox user's home under cryfs.")
    parser.add_argument("user", help="the sandbox user whose home to encrypt")
    username = parser.parse_args(rest).user
    if not USERNAME_RE.match(username):
        raise SystemExit(f"invalid user '{username}': expected {USERNAME_RE.pattern}")
    config = load_settings("key_command")
    homes = Path(config["homes"]).expanduser()
    home = homes / username
    cipher = cipher_dir(homes, username)
    staging = staging_dir(homes, username)
    if staging.exists():
        raise SystemExit(f"'{staging}' is left from an attempt that was killed.\n"
                         f"Unmount it if it is mounted, remove it and '{cipher}', then try again.")
    if cipher.is_dir():
        print(f"The home of '{username}' is already encrypted.")
        return
    if home.is_symlink():
        raise SystemExit(f"refusing to encrypt '{home}': it is a symbolic link")
    if mounted(home):
        raise SystemExit(f"refusing to encrypt '{home}': something is mounted on it")
    if not shutil.which("cryfs"):
        raise SystemExit("encrypting a home needs 'cryfs'; is the cryfs package installed?")
    if process_with("--bind", str(home)):
        raise SystemExit(f"a sandbox of '{username}' runs; exit it first.")
    passphrase = new_passphrase(config, username)
    home.mkdir(parents=True, exist_ok=True)
    cipher.mkdir()
    staging.mkdir()
    try:
        skipped = fill_cipher(home, cipher, staging, passphrase)
    except BaseException:
        subprocess.run(["fusermount", "-u", str(staging)], capture_output=True)
        shutil.rmtree(cipher, ignore_errors=True)
        shutil.rmtree(staging, ignore_errors=True)
        raise
    staging.rmdir()
    shutil.rmtree(home)
    home.mkdir()
    print(f"Encrypted '{home}' into '{cipher}'.")
    if skipped:
        print(f"Left out {skipped} special file(s): a socket, a pipe or a device cannot live "
              f"in cryfs.")


def read_sysctl(name):
    try:
        return (Path("/proc/sys") / name.replace(".", "/")).read_text().strip()
    except FileNotFoundError:
        return None


def sysctl_row(name, value, namespaces_work):
    """The state of one sysctl, given what bwrap itself managed.

    A denying value is the cause only when the probe failed: an AppArmor
    profile can let bwrap through while the sysctl still reads 1.
    """
    denying, allowing, meaning = SYSCTLS[name]
    if value is None:
        return OK, "absent", None
    if value != denying:
        return OK, value, None
    if namespaces_work:
        return OK, f"{value}, but bwrap works regardless", None
    return FAIL, f"{value}: {meaning}", f"sudo sysctl -w {name}={allowing}"


def tiocsti_row(value, filtered):
    """The state of TIOCSTI. Before Linux 6.2 the sysctl is absent, and the
    kernel always allows it."""
    shown = value or "absent"
    if filtered:
        return OK, f"{shown}, and the seccomp filter of corral refuses TIOCSTI"
    if value == "0":
        return OK, value
    return WARN, (f"{shown}, and corral has no seccomp filter for this machine: the sandbox "
                  f"can type into the shell that started it")


def tool_version(tool):
    output = subprocess.run([tool, "--version"], capture_output=True, text=True).stdout
    return output.partition("\n")[0]


def probe(command):
    """Whether the command ran, and otherwise the last line it wrote to
    stderr, which is where bwrap and pasta say what went wrong."""
    run = subprocess.run(command, capture_output=True, text=True)
    if run.returncode == 0:
        return True, ""
    lines = run.stderr.strip().splitlines()
    return False, lines[-1] if lines else f"exit status {run.returncode}"


def check_host(rest):
    argparse.ArgumentParser(prog="corral check",
                            description="Report what this host is missing.").parse_args(rest)
    rows = []
    remedies = []
    namespaces_work = False
    if not shutil.which("bwrap"):
        rows.append(("bwrap", FAIL, "not on PATH; install bubblewrap"))
    else:
        version = tool_version("bwrap")
        if bwrap_has_overlay():
            rows.append(("bwrap", OK, version))
        else:
            rows.append(("bwrap", WARN, f"{version}, older than 0.11.0, so ':tmp' mounts "
                                        f"are unavailable"))
        namespaces_work, error = probe([
            "bwrap", "--ro-bind", "/", "/", "--unshare-user",
            "--uid", str(os.getuid()), "--gid", str(os.getgid()),
            "--unshare-pid", "--unshare-ipc", "--unshare-uts", "--unshare-net", "--", "true"])
        if namespaces_work:
            rows.append(("user namespace", OK, "bwrap can create one"))
        else:
            rows.append(("user namespace", FAIL, error))
    for name in SYSCTLS:
        state, detail, remedy = sysctl_row(name, read_sysctl(name), namespaces_work)
        rows.append((name, state, detail))
        if remedy:
            remedies.append(remedy)
    state, detail = tiocsti_row(read_sysctl("dev.tty.legacy_tiocsti"),
                                tty_filter(platform.machine()) is not None)
    rows.append(("dev.tty.legacy_tiocsti", state, detail))
    if not shutil.which("pasta"):
        rows.append(("pasta", WARN, "not on PATH; the 'private' network mode needs it, "
                                    "from the passt package"))
    else:
        version = tool_version("pasta")
        works, error = probe(["pasta", "--config-net", "--no-map-gw", "--quiet", "--", "true"])
        if works:
            rows.append(("pasta", OK, version))
        else:
            rows.append(("pasta", WARN, f"{version}, cannot run: {error}; 'private' will "
                                        f"fail, so use -n host or -n none"))
    if not shutil.which("wg"):
        rows.append(("wg", WARN, "not on PATH; --vpn needs it, from the wireguard-tools package"))
    else:
        rows.append(("wg", OK, tool_version("wg")))
    if not shutil.which("cryfs"):
        rows.append(("cryfs", WARN, "not on PATH; an encrypted home needs it, from the cryfs "
                                    "package"))
    else:
        rows.append(("cryfs", OK, tool_version("cryfs")))

    width = max(len(subject) for subject, _, _ in rows)
    for subject, state, detail in rows:
        print(f"{subject:<{width}}  {state:<4}  {detail}")
    if remedies:
        print("\nTo fix it:")
        for remedy in remedies:
            print(f"  {remedy}")
        print("The same setting in /etc/sysctl.d/ keeps it across reboots.")
    if any(state == FAIL for _, state, _ in rows):
        raise SystemExit(1)


def read_table(path, label):
    try:
        return tomllib.loads(path.read_text())
    except tomllib.TOMLDecodeError as error:
        raise SystemExit(f"malformed {label}: {error}")


def read_project():
    path = CWD / PROJECT_FILE
    if not path.is_file():
        return {}
    project = read_table(path, f"'{PROJECT_FILE}'")
    if "force" in project:
        raise SystemExit(f"refusing 'force' from '{PROJECT_FILE}': only the command line can "
                         f"lift the guard on the home directory and '/'.")
    for key, value in project.items():
        if key not in PROJECT_KEYS:
            raise SystemExit(f"unknown key '{key}' in '{PROJECT_FILE}': "
                             f"expected one of {', '.join(PROJECT_KEYS)}")
        if key in ("mounts", "env"):
            if not (isinstance(value, list) and all(isinstance(item, str) for item in value)):
                raise SystemExit(f"'{key}' in '{PROJECT_FILE}' must be a list of strings")
        elif not isinstance(value, str):
            raise SystemExit(f"'{key}' in '{PROJECT_FILE}' must be a string")
    if "network" in project and project["network"] not in NETWORKS:
        raise SystemExit(f"invalid network '{project['network']}' in '{PROJECT_FILE}': "
                         f"expected one of {', '.join(NETWORKS)}")
    if "user" in project and not USERNAME_RE.match(project["user"]):
        raise SystemExit(f"invalid user '{project['user']}' in '{PROJECT_FILE}': "
                         f"expected {USERNAME_RE.pattern}")
    return project


def env_names(specs):
    return {spec.partition("=")[0] for spec in specs}


def project_env(project, args):
    given = env_names(args.env)
    return [spec for spec in project.get("env", []) if spec.partition("=")[0] not in given]


def project_flags(project, args):
    """What the file adds, as the flags it stands for.

    A flag replaces the file's network or user, and drops the file's entry for
    the same variable. Mounts add up: the flag's is emitted after the file's,
    so it covers the file's when both name one target.
    """
    flags = []
    if "network" in project and not args.net:
        flags += ["-n", project["network"]]
    if "user" in project and not args.user:
        flags += ["-u", project["user"]]
    for spec in project.get("mounts", []):
        flags += ["-m", spec]
    for spec in project_env(project, args):
        flags += ["-e", spec]
    return flags


def setting(sources, key):
    """The label and the value of KEY in the last of SOURCES that has it."""
    for label, table in reversed(sources):
        if key in table:
            return label, table[key]
    return None, None


def config_list(table, key, label):
    value = table.get(key, [])
    if not (isinstance(value, list) and all(isinstance(item, str) for item in value)):
        raise SystemExit(f"'{key}' in '{label}' must be a list of strings")
    return value


def config_mounts(sources):
    mounts = []
    for label, table in sources:
        for spec in config_list(table, "mounts", label):
            # The config applies to every project, so a relative path would
            # name a different directory in each one.
            if not Path(spec.split(":")[0]).expanduser().is_absolute():
                raise SystemExit(f"invalid mount '{spec}' in '{label}': the host path must "
                                 f"be absolute or start with '~'")
            mounts.append((label, spec))
    return mounts


def config_hide(sources):
    paths = []
    for label, table in sources:
        for spec in config_list(table, "hide", label):
            path = Path(spec).expanduser()
            if not path.is_absolute():
                raise SystemExit(f"invalid path '{spec}' under 'hide' in '{label}': it must "
                                 f"be absolute or start with '~'")
            if path.resolve() == Path("/"):
                raise SystemExit(f"cannot hide '/' from '{label}': nothing would be left")
            paths.append(spec)
    return paths


def config_env(sources, project, args):
    """The variables of each source, without those that a later source, the
    project file or a flag replaces."""
    given = env_names(project.get("env", []) + args.env)
    kept = []
    for label, table in reversed(sources):
        specs = config_list(table, "env", label)
        kept.insert(0, [spec for spec in specs if spec.partition("=")[0] not in given])
        given |= env_names(specs)
    return kept


def config_flags(sources, project, args):
    """What each source adds, as its label and the flags it stands for.

    Every project gets these, so they are the most easily forgotten. A
    variable, a VPN or a display that a later source, the project file or a
    flag replaces is left out. SOURCES hold the text as written, so that a
    secret behind '$(...)' never reaches the terminal.
    """
    vpn_label = None if args.vpn else setting(sources, "vpn")[0]
    wayland_label = None if args.wayland is not None else setting(sources, "wayland")[0]
    lines = []
    for (label, table), env in zip(sources, config_env(sources, project, args)):
        flags = []
        for spec in config_list(table, "mounts", label):
            flags += ["-m", spec]
        for spec in env:
            flags += ["-e", spec]
        if label == vpn_label:
            flags += ["--vpn", table["vpn"]]
        if label == wayland_label and table["wayland"]:
            flags += ["-w"]
        if flags:
            lines.append((label, flags))
    return lines


def load_config():
    config = {}
    if CONFIG_PATH.exists():
        config = read_table(CONFIG_PATH, f"config '{CONFIG_PATH}'")
    return {"homes": DEFAULT_HOMES, **config}


def user_sources(config, username):
    """The section of USERNAME in CONFIG, then its file, as (label, table)."""
    users = config.get("users", {})
    if not isinstance(users, dict):
        raise SystemExit(f"'users' in '{CONFIG_PATH}' must be a table")
    sources = []
    if username in users:
        sources.append((f"{CONFIG_PATH} [users.{username}]", users[username]))
    path = USERS_DIR / f"{username}.toml"
    if path.exists():
        sources.append((path, read_table(path, f"config '{path}'")))
    for label, table in sources:
        if not isinstance(table, dict):
            raise SystemExit(f"'{label}' must be a table")
        for key in table:
            if key not in USER_KEYS:
                raise SystemExit(f"invalid key '{key}' in '{label}': expected one of "
                                 f"{', '.join(USER_KEYS)}")
    return sources


def run_command(command, key, label):
    # stdin and stderr stay on the terminal, so that 'pass' can ask for the
    # passphrase.
    result = subprocess.run(["sh", "-c", command], stdout=subprocess.PIPE, text=True)
    if result.returncode != 0:
        raise SystemExit(f"'$({command})' for '{key}' in '{label}' failed "
                         f"with status {result.returncode}")
    return result.stdout.rstrip("\n")


def host_variable(name, key, label):
    if not ENV_NAME_RE.match(name):
        raise SystemExit(f"invalid variable name '{name}' for '{key}' in '{label}'")
    if name not in os.environ:
        # Empty would turn '$DATA/x' into '/x' without a word.
        raise SystemExit(f"'{name}' for '{key}' in '{label}' is not set on the host")
    return os.environ[name]


def closing_parenthesis(text, start, label):
    depth = 0
    for index in range(start, len(text)):
        if text[index] == "(":
            depth += 1
        elif text[index] == ")":
            depth -= 1
            if depth == 0:
                return index
    raise SystemExit(f"unterminated '$(' in '{text}' in '{label}'")


def expand(text, key, label):
    """Replace '$(command)', '$NAME' and '${NAME}' with what they give on the
    host, and '$$' with '$'. A '$' before anything else stays as it is."""
    parts = []
    index = 0
    while (dollar := text.find("$", index)) != -1:
        parts.append(text[index:dollar])
        rest = text[dollar + 1:]
        if rest.startswith("$"):
            parts.append("$")
            index = dollar + 2
        elif rest.startswith("("):
            end = closing_parenthesis(text, dollar + 1, label)
            parts.append(run_command(text[dollar + 2:end], key, label))
            index = end + 1
        elif rest.startswith("{"):
            end = text.find("}", dollar)
            if end == -1:
                raise SystemExit(f"unterminated '${{' in '{text}' in '{label}'")
            parts.append(host_variable(text[dollar + 2:end], key, label))
            index = end + 1
        elif name := VARIABLE_RE.match(rest):
            parts.append(host_variable(name.group(), key, label))
            index = dollar + 1 + name.end()
        else:
            parts.append("$")
            index = dollar + 1
    parts.append(text[index:])
    return "".join(parts)


def expand_table(table, label):
    """TABLE with every value expanded, but not the values of a table in it.

    The text as written stays in TABLE, because that is what goes onto the
    terminal.
    """
    expanded = {}
    for key, value in table.items():
        if isinstance(value, list):
            expanded[key] = [expand(item, key, label) if isinstance(item, str) else item
                             for item in value]
        elif isinstance(value, str):
            expanded[key] = expand(value, key, label)
        else:
            expanded[key] = value
    return expanded


def expand_config(config):
    """The config with every value expanded, and the homes root created."""
    expanded = expand_table(config, CONFIG_PATH)
    Path(expanded["homes"]).expanduser().mkdir(parents=True, exist_ok=True)
    return expanded


def load_settings(*keys):
    """The expanded config, with only KEYS and 'homes' in it.

    A command in another value can ask for a passphrase, as 'pass' does, and
    only a start has a use for its output.
    """
    config = load_config()
    return expand_config({key: config[key] for key in ("homes", *keys) if key in config})


def main():
    if sys.argv[1:2] == [VPN_HELPER]:
        vpn_helper(Path(sys.argv[2]), sys.argv[3:])

    parser = argparse.ArgumentParser(
        prog="corral",
        # Spelled out because argparse renders a trailing REMAINDER as a bare
        # '...' on a line of its own, which names nothing.
        usage="corral [OPTION ...] [COMMAND [ARG ...]]\n"
              "       corral list\n"
              "       corral remove USER\n"
              "       corral encrypt USER\n"
              "       corral check",
        description="Run a shell that sees the host read only and writes only to a home "
                    "of its own. With -p, the current directory is writable too.",
        epilog=f"'list' shows the sandbox homes, 'remove' deletes one, 'encrypt' puts one "
               f"under cryfs and 'check' reports what this host is missing; put '--' first "
               f"to run a program by one of those names. Settings live in '{CONFIG_PATH}', "
               f"which is optional, and for one sandbox user also in its section "
               f"[users.USER] and in '{USERS_DIR}/USER.toml'. With "
               f"-p, a '{PROJECT_FILE}' in the project adds flags for it.",
    )
    parser.add_argument("-p", "--project", action="store_true",
                        help="the current directory is the project: writable, where the "
                             "shell starts, and its '.corral.toml' applies")
    parser.add_argument("-u", "--user", help="sandbox user to run as")
    parser.add_argument("-m", "--mount", action="append", default=[],
                        metavar="HOST[:GUEST[:ro|rw|tmp]]",
                        help="bind another host path, read only unless ':rw', or ':tmp' for "
                             "writes that the host never sees; with -p, '.' is the "
                             "project itself")
    parser.add_argument("-e", "--env", action="append", default=[], metavar="NAME[=VALUE]",
                        help="set a variable, or forward the host's value")
    parser.add_argument("-n", "--net", choices=NETWORKS, help="network mode for this run")
    parser.add_argument("--vpn", metavar="FILE",
                        help="send all traffic through the WireGuard tunnel of this wg-quick "
                             "config; needs the 'private' network mode")
    parser.add_argument("-w", "--wayland", action=argparse.BooleanOptionalAction,
                        help="bind the host's Wayland socket, for a GUI program; "
                             "--no-wayland overrides the 'wayland' key")
    parser.add_argument("--force", action="store_true",
                        help="allow the home directory or '/' as the project")
    parser.add_argument("--dry-run", action="store_true", help="print the command and exit")
    parser.add_argument("--version", action="version", version=f"corral {VERSION}")
    parser.add_argument("command", nargs=argparse.REMAINDER, metavar="COMMAND",
                        help="run this instead of the login shell; every argument "
                             "after it belongs to it")
    args = parser.parse_args()

    if os.environ.get("CORRAL"):
        # Nesting mostly works, and what it produces is never what was meant:
        # the inner sandbox is built from this one's read-only rootfs and
        # emptied /home, so 'the rest of the host' is already gone.
        inner = os.environ.get("CORRAL_USER") or "?"
        raise SystemExit(f"already inside the '{inner}' sandbox.\n"
                         f"Exit first, or run 'env -u CORRAL corral' to nest deliberately.")

    # REMAINDER hands the separator over with the rest, so '--' would arrive as
    # the program to run. Only the first one is corral's; a later one is the
    # command's own. It also makes a 'list', 'remove' or 'check' after it a
    # program to run rather than corral's own verb.
    verbs = {"list": list_homes, "remove": remove_home, "encrypt": encrypt_home,
             "check": check_host}
    if args.command[:1] == ["--"]:
        del args.command[0]
    elif args.command and args.command[0] in verbs:
        verbs[args.command[0]](args.command[1:])
        return

    if not shutil.which("bwrap"):
        raise SystemExit("bwrap was not found on PATH; is bubblewrap installed?")

    project = read_project() if args.project else {}
    config = load_config()
    settings = expand_config(config)
    username = choose_user(settings, project, args)
    users = user_sources(config, username)
    sources = [(CONFIG_PATH, settings)] + [(label, expand_table(table, label))
                                           for label, table in users]
    command = build_command(sources, project, args, username)
    homes = Path(settings["homes"]).expanduser()
    home = prepare_home(homes, username, settings, args.dry_run)
    for label, flags in config_flags([(CONFIG_PATH, config)] + users, project, args):
        print(f"{label}: {shlex.join(flags)}", file=sys.stderr)
    flags = project_flags(project, args)
    if flags:
        print(f"{PROJECT_FILE}: {shlex.join(flags)}", file=sys.stderr)
    if args.dry_run:
        print(shlex.join(command))
        return
    if cipher_dir(homes, username).is_dir():
        raise SystemExit(run_and_lock(command, home))
    raise SystemExit(run_sandbox(command))


if __name__ == "__main__":
    try:
        main()
    except (EOFError, KeyboardInterrupt):
        raise SystemExit("\nAborted.")
