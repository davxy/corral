# For each machine, the system calls that are ioctl, as the AUDIT_ARCH value
# and the call numbers. A 64-bit kernel also runs 32-bit programs, and x86_64
# also x32 ones.
IOCTL_CALLS = {
    "x86_64": ((0xC000003E, (16, 0x40000202)), (0x40000003, (54,))),
